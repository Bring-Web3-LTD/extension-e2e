# ── required ────────────────────────────────────────────────────────
# The platform whose key builds the environment's extension. Sent to the
# deployer as FRONTEND_IDENTIFIER; without it the deploy dies before a browser
# opens. Same names the QA automation uses, so an existing .env works as-is.
ECKO_API_KEY=

# AWS comes from the usual place (aws configure / AWS_PROFILE / a CI role).
# Needs ECS, CloudFormation and S3 read.

# ── optional ────────────────────────────────────────────────────────
AWS_REGION=eu-central-1
BRING_ENV_NAME=qa-extension
BRING_PLATFORM=ecko
BRING_BACKEND_BRANCH=main
BRING_FRONTEND_BRANCH=main

# Which shops to test, and which search engine the offer bar is reached through.
# BRING_RETAILERS=https://www.aliexpress.com,https://www.missoma.com
# BRING_RETAILER=missoma          # pin the run to one lane
# BRING_SEARCH_ENGINE=google      # the only engine the offer bar is live on

# ── notification variants (section 3) ───────────────────────────────
# The five variants are decided by rows in the environment's `purchases`
# table, so seeding them needs the database. Without these, those tests skip
# with a reason and everything else runs.
#   python -m bring.db --inspect     prints the real schema before anything is written
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# DB_NAME=                        # left blank, the environment's own DB is looked up
# The database sits behind a bastion; leave blank when connecting directly.
DB_SSH_HOST=
DB_SSH_USER=
DB_SSH_PORT=22
DB_SSH_KEY_PATH=
