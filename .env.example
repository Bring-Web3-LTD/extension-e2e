# Platform whose API key builds the environment's extension.
# Same key names the QA automation uses, so an existing .env works as-is.
ECKO_API_KEY=
YOROI_API_KEY=

# Optional. Only needed to force notification variants (section 3 of the
# QA plan): the variant comes from rows in the environment's purchases table.
# Without these, those tests skip instead of failing.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
